{
  "schema": "skill.package.v1",
  "id": "wave",
  "version": "0.1.0",
  "title": "挥手",
  "description": "机械臂抬起后左右摆动并开合夹爪，最后回到零位。需要至少 6 自由度机械臂和夹爪。",
  "entry": "skill.py:Wave",
  "requires": [{"id": "arm.joint_position"}, {"id": "gripper.position"}],
  "optional": [{"id": "joint.state"}],
  "constraints": {"arm.joint_position": {"dof": {"min": 6}}},
  "parameters": [
    {"name": "cycles", "type": "int", "required": false, "default": 2, "title": "挥手次数", "description": "左右摆动几个来回", "unit": "次", "min": 1, "max": 10},
    {"name": "amplitude", "type": "float", "required": false, "default": 0.6, "title": "摆动幅度", "description": "每次向左右摆动的角度", "unit": "rad", "min": 0.1, "max": 1.0}
  ],
  "timeout_s": 120
}
